# /srv/eerc/shared/.env — 正式主機環境設定範本
#
#   sudo cp deploy/ubuntu/env.production.example /srv/eerc/shared/.env
#   sudo chown root:eerc /srv/eerc/shared/.env && sudo chmod 640 /srv/eerc/shared/.env
#
# 🔒 這份「範本」可以放進 GitHub；填好真實值的 .env 絕對不可以 commit、不可以寄信、不可以截圖。
#    密碼與金鑰請在簽約與保密文件完成後，當面或用安全方式交付。

# ── 必填 ─────────────────────────────────────────────
# 本機 PostgreSQL 16（由 setup-server.sh 建立的帳號）
DATABASE_URL="postgresql://eerc:請換成強密碼@127.0.0.1:5432/eerc?schema=public"

# 登入金鑰：至少 32 字元，少於 32 字元網站會「刻意」啟動失敗（fail-fast）
# 產生方式：openssl rand -base64 48
JWT_SECRET="請用 openssl rand -base64 48 產生"

# 上傳檔案存放位置（放在發佈目錄以外，Nginx 由此提供 /uploads/）
UPLOAD_DIR="/srv/eerc/uploads"

# 網站正式網址（產生絕對網址用）
NEXT_PUBLIC_SITE_URL="https://englishcenter.kl.edu.tw"
# 轉址用的正式網址（必填）：沒設的話，進首頁或後台時會被導到 https://localhost:3000/…
PUBLIC_ORIGIN="https://englishcenter.kl.edu.tw"
SITE_NAME="基隆市英語資源中心"

# ── 選填：聯絡表單 Email 通知 ─────────────────────────
# 沒填就不寄通知信，聯絡表單仍會正常存進資料庫
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
CONTACT_NOTIFY_EMAIL=""

# ── 不要設定 ─────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN、AWS_S3_BUCKET、AWS_* 這幾個「不要」出現在正式主機上。
# 只要沒設，上傳就會自動存到上面的 UPLOAD_DIR；一旦設了，檔案會被傳到外部雲端。
